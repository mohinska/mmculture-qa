# Copy to .env and fill in.

# Folder that contains data/ (and by default asr/, preds/).
# Empty = this repo folder (data/, asr/, preds/ are gitignored).
MMCQA_ROOT=

# Where asr/ and preds/ are written. Empty = same as MMCQA_ROOT.
# Point it to a shared Drive folder to exchange transcripts/predictions.
# On Kaggle: /kaggle/working
MMCQA_OUT=

# Hugging Face token (https://huggingface.co/settings/tokens, read access)
HF_TOKEN=
